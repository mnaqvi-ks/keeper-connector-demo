{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Sample Logic App that exposes an HTTP endpoint and creates a new Keeper secret in a shared folder. POST a JSON body with the secret fields (folder_uid, title, login, password, url, notes) to the workflow's callback URL, and the response body contains the created secret JSON returned by the Keeper Secrets Manager middleware via the certified connector."
  },
  "parameters": {
    "logicAppName": {
      "type": "string",
      "defaultValue": "la-keeper-create-secret-sample",
      "metadata": { "description": "Name of the Logic App resource that will be created." }
    },
    "functionAppHostname": {
      "type": "string",
      "metadata": { "description": "Hostname of the Keeper middleware Function App, e.g. keeper-middleware-acme.azurewebsites.net" }
    },
    "functionHostKey": {
      "type": "securestring",
      "metadata": { "description": "Default host key from the Function App's App keys (sent as the x-functions-key header by the connector)." }
    },
    "keeperApiId": {
      "type": "string",
      "defaultValue": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/keepersecretsmanager')]",
      "metadata": { "description": "Resource ID of the Keeper API. Defaults to the certified managed API for the deployment region. Override with a customApis/... ID for pre-cert testing against a custom connector." }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": { "description": "Azure region for the Logic App and connection." }
    }
  },
  "variables": {
    "keeperConnectionName": "[concat(parameters('logicAppName'), '-keeper')]",
    "workflowSchema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('keeperConnectionName')]",
      "location": "[parameters('location')]",
      "properties": {
        "displayName": "Keeper Secrets Manager",
        "api": {
          "id": "[parameters('keeperApiId')]"
        },
        "parameterValues": {
          "Function App hostname": "[parameters('functionAppHostname')]",
          "API key": "[parameters('functionHostKey')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2017-07-01",
      "name": "[parameters('logicAppName')]",
      "location": "[parameters('location')]",
      "tags": {
        "displayName": "[parameters('logicAppName')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('keeperConnectionName'))]"
      ],
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "[variables('workflowSchema')]",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "type": "Object",
              "defaultValue": {}
            }
          },
          "triggers": {
            "manual": {
              "type": "Request",
              "kind": "Http",
              "inputs": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "folder_uid": { "type": "string" },
                    "title": { "type": "string" },
                    "login": { "type": "string" },
                    "password": { "type": "string" },
                    "url": { "type": "string" },
                    "notes": { "type": "string" }
                  },
                  "required": ["folder_uid", "title"]
                }
              }
            }
          },
          "actions": {
            "Create_Secret": {
              "type": "ApiConnection",
              "runAfter": {},
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['keeper']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/secrets",
                "body": "@triggerBody()"
              }
            },
            "Response": {
              "type": "Response",
              "kind": "Http",
              "runAfter": {
                "Create_Secret": ["Succeeded"]
              },
              "inputs": {
                "statusCode": 200,
                "body": "@body('Create_Secret')"
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "keeper": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('keeperConnectionName'))]",
                "connectionName": "[variables('keeperConnectionName')]",
                "id": "[parameters('keeperApiId')]"
              }
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "name": {
      "type": "string",
      "value": "[parameters('logicAppName')]"
    },
    "resourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Logic/workflows', parameters('logicAppName'))]"
    },
    "resourceGroupName": {
      "type": "string",
      "value": "[resourceGroup().name]"
    },
    "location": {
      "type": "string",
      "value": "[parameters('location')]"
    },
    "keeperConnectionName": {
      "type": "string",
      "value": "[variables('keeperConnectionName')]"
    },
    "httpPostUrl": {
      "type": "string",
      "value": "[listCallbackURL(concat(resourceId('Microsoft.Logic/workflows', parameters('logicAppName')), '/triggers/manual'), '2017-07-01').value]"
    },
    "nextSteps": {
      "type": "string",
      "value": "[concat('Deployed. Test with: curl -X POST <httpPostUrl> -H \"Content-Type: application/json\" -d ''{\"folder_uid\":\"<shared-folder-uid>\",\"title\":\"Test Secret\",\"login\":\"user@example.com\",\"password\":\"P@ss123!\",\"url\":\"https://example.com\"}''. The response body contains the newly created secret JSON including its UID. Run history for ', parameters('logicAppName'), ' shows each invocation and the connector call output.')]"
    }
  }
}
