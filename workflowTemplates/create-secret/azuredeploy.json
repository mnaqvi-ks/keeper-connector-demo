{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Sample Logic App that exposes an HTTP endpoint and creates a new Keeper secret in a shared folder. POST a JSON body with the secret fields (folder_uid, title, login, password, url, notes) to the workflow's callback URL, and the response body contains the created secret JSON returned by the Keeper Secrets Manager middleware via the certified connector. Requires an existing Microsoft.Web/connections resource in the same resource group (created once via the portal -> API Connections -> + Add)."
  },
  "parameters": {
    "logicAppName": {
      "type": "string",
      "defaultValue": "la-keeper-create-secret-sample",
      "metadata": { "description": "Name of the Logic App resource that will be created." }
    },
    "connectionName": {
      "type": "string",
      "metadata": { "description": "Name of the EXISTING Keeper Secrets Manager API connection in this resource group. Create it once in the Azure portal (API Connections -> + Add -> pick the Keeper connector -> fill the form), then pass its name here." }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": { "description": "Azure region for the Logic App." }
    }
  },
  "variables": {
    "workflowSchema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "connectionResourceId": "[resourceId('Microsoft.Web/connections', parameters('connectionName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2017-07-01",
      "name": "[parameters('logicAppName')]",
      "location": "[parameters('location')]",
      "tags": {
        "displayName": "[parameters('logicAppName')]"
      },
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "[variables('workflowSchema')]",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "type": "Object",
              "defaultValue": {}
            }
          },
          "triggers": {
            "manual": {
              "type": "Request",
              "kind": "Http",
              "inputs": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "folder_uid": { "type": "string" },
                    "title": { "type": "string" },
                    "login": { "type": "string" },
                    "password": { "type": "string" },
                    "url": { "type": "string" },
                    "notes": { "type": "string" }
                  },
                  "required": ["folder_uid", "title"]
                }
              }
            }
          },
          "actions": {
            "Create_Secret": {
              "type": "ApiConnection",
              "runAfter": {},
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['keeper']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/secrets",
                "body": "@triggerBody()"
              }
            },
            "Response": {
              "type": "Response",
              "kind": "Http",
              "runAfter": {
                "Create_Secret": ["Succeeded"]
              },
              "inputs": {
                "statusCode": 200,
                "body": "@body('Create_Secret')"
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "keeper": {
                "connectionId": "[variables('connectionResourceId')]",
                "connectionName": "[parameters('connectionName')]",
                "id": "[reference(variables('connectionResourceId'), '2016-06-01', 'Full').properties.api.id]"
              }
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "name": {
      "type": "string",
      "value": "[parameters('logicAppName')]"
    },
    "resourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Logic/workflows', parameters('logicAppName'))]"
    },
    "resourceGroupName": {
      "type": "string",
      "value": "[resourceGroup().name]"
    },
    "location": {
      "type": "string",
      "value": "[parameters('location')]"
    },
    "connectionName": {
      "type": "string",
      "value": "[parameters('connectionName')]"
    },
    "httpPostUrl": {
      "type": "string",
      "value": "[listCallbackURL(concat(resourceId('Microsoft.Logic/workflows', parameters('logicAppName')), '/triggers/manual'), '2017-07-01').value]"
    },
    "nextSteps": {
      "type": "string",
      "value": "[concat('Deployed. Test with: curl -X POST <httpPostUrl> -H \"Content-Type: application/json\" -d ''{\"folder_uid\":\"<shared-folder-uid>\",\"title\":\"Test Secret\",\"login\":\"user@example.com\",\"password\":\"P@ss123!\",\"url\":\"https://example.com\"}''. The response body contains the newly created secret JSON including its UID. Run history for ', parameters('logicAppName'), ' shows each invocation and the connector call output.')]"
    }
  }
}
