{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Sample Logic App that updates a single Keeper secret on a recurrence schedule. Each run stamps a UTC timestamp into the secret's notes field via the certified Keeper Secrets Manager connector. Useful as a smoke test for the connector + middleware deployment. Requires an existing Microsoft.Web/connections resource in the same resource group (created once via the portal -> API Connections -> + Add)."
  },
  "parameters": {
    "logicAppName": {
      "type": "string",
      "defaultValue": "la-keeper-update-secret-sample",
      "metadata": { "description": "Name of the Logic App resource that will be created." }
    },
    "connectionName": {
      "type": "string",
      "metadata": { "description": "Name of the EXISTING Keeper Secrets Manager API connection in this resource group. Create it once in the Azure portal (API Connections -> + Add -> pick the Keeper connector -> fill the form), then pass its name here." }
    },
    "secretUid": {
      "type": "string",
      "metadata": { "description": "UID of the Keeper secret to update on every run. Must be in a folder shared with the KSM application backing the middleware." }
    },
    "recurrenceIntervalMinutes": {
      "type": "int",
      "defaultValue": 5,
      "minValue": 1,
      "metadata": { "description": "How often (in minutes) the workflow runs and updates the secret." }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": { "description": "Azure region for the Logic App." }
    }
  },
  "variables": {
    "workflowSchema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "connectionResourceId": "[resourceId('Microsoft.Web/connections', parameters('connectionName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2017-07-01",
      "name": "[parameters('logicAppName')]",
      "location": "[parameters('location')]",
      "tags": {
        "displayName": "[parameters('logicAppName')]"
      },
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "[variables('workflowSchema')]",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "type": "Object",
              "defaultValue": {}
            },
            "secretUid": {
              "type": "String",
              "defaultValue": ""
            }
          },
          "triggers": {
            "Recurrence": {
              "type": "Recurrence",
              "recurrence": {
                "frequency": "Minute",
                "interval": "[parameters('recurrenceIntervalMinutes')]"
              }
            }
          },
          "actions": {
            "Update_Secret": {
              "type": "ApiConnection",
              "runAfter": {},
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['keeper']['connectionId']"
                  }
                },
                "method": "put",
                "path": "/secrets/@{encodeURIComponent(parameters('secretUid'))}",
                "body": {
                  "notes": "Updated at @{utcNow()}"
                }
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "keeper": {
                "connectionId": "[variables('connectionResourceId')]",
                "connectionName": "[parameters('connectionName')]",
                "id": "[reference(variables('connectionResourceId'), '2016-06-01', 'Full').properties.api.id]"
              }
            }
          },
          "secretUid": {
            "value": "[parameters('secretUid')]"
          }
        }
      }
    }
  ],
  "outputs": {
    "name": {
      "type": "string",
      "value": "[parameters('logicAppName')]"
    },
    "resourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Logic/workflows', parameters('logicAppName'))]"
    },
    "resourceGroupName": {
      "type": "string",
      "value": "[resourceGroup().name]"
    },
    "location": {
      "type": "string",
      "value": "[parameters('location')]"
    },
    "connectionName": {
      "type": "string",
      "value": "[parameters('connectionName')]"
    },
    "nextSteps": {
      "type": "string",
      "value": "[concat('Deployed. To verify quickly without waiting, open Logic App ', parameters('logicAppName'), ' > Overview > Run Trigger > Recurrence. Then check Run history for a successful Update_Secret action and confirm the notes field of secret ', parameters('secretUid'), ' is updated in your Keeper vault.')]"
    }
  }
}
