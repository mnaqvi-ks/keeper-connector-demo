{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Sample Logic App that updates a single Keeper secret on a recurrence schedule. Each run stamps a UTC timestamp into the secret's notes field via the certified Keeper Secrets Manager connector. Useful as a smoke test for the connector + middleware deployment."
  },
  "parameters": {
    "logicAppName": {
      "type": "string",
      "defaultValue": "la-keeper-update-secret-sample",
      "metadata": { "description": "Name of the Logic App resource that will be created." }
    },
    "connectionName": {
      "type": "string",
      "defaultValue": "keeper-secrets-manager",
      "metadata": { "description": "Name of the API connection to the Keeper Secrets Manager connector. Pass the same value across multiple workflow templates to reuse a single connection (ARM updates the existing connection in place)." }
    },
    "secretUid": {
      "type": "string",
      "metadata": { "description": "UID of the Keeper secret to update on every run. Must be in a folder shared with the KSM application backing the middleware." }
    },
    "recurrenceIntervalMinutes": {
      "type": "int",
      "defaultValue": 5,
      "minValue": 1,
      "metadata": { "description": "How often (in minutes) the workflow runs and updates the secret." }
    },
    "functionAppHostname": {
      "type": "string",
      "metadata": { "description": "Hostname of the Keeper middleware Function App, e.g. keeper-middleware-acme.azurewebsites.net" }
    },
    "functionHostKey": {
      "type": "securestring",
      "metadata": { "description": "Default host key from the Function App's App keys (sent as the x-functions-key header by the connector)." }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": { "description": "Azure region for the Logic App and connection." }
    },
    "keeperApiIdOverride": {
      "type": "string",
      "defaultValue": "",
      "metadata": { "description": "Advanced: leave blank unless overriding to a custom connector. Defaults to the certified Keeper Secrets Manager managed API for the deployment region. For pre-cert testing, set this to the resource ID of your Microsoft.Web/customApis/... connector." }
    }
  },
  "variables": {
    "defaultKeeperApiId": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', parameters('location'), '/managedApis/keeper-secrets-manager')]",
    "effectiveKeeperApiId": "[if(empty(parameters('keeperApiIdOverride')), variables('defaultKeeperApiId'), parameters('keeperApiIdOverride'))]",
    "workflowSchema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[parameters('connectionName')]",
      "location": "[parameters('location')]",
      "properties": {
        "displayName": "Keeper Secrets Manager",
        "api": {
          "id": "[variables('effectiveKeeperApiId')]"
        },
        "parameterValues": {
          "Function App hostname": "[parameters('functionAppHostname')]",
          "API key": "[parameters('functionHostKey')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2017-07-01",
      "name": "[parameters('logicAppName')]",
      "location": "[parameters('location')]",
      "tags": {
        "displayName": "[parameters('logicAppName')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', parameters('connectionName'))]"
      ],
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "[variables('workflowSchema')]",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "type": "Object",
              "defaultValue": {}
            },
            "secretUid": {
              "type": "String",
              "defaultValue": ""
            }
          },
          "triggers": {
            "Recurrence": {
              "type": "Recurrence",
              "recurrence": {
                "frequency": "Minute",
                "interval": "[parameters('recurrenceIntervalMinutes')]"
              }
            }
          },
          "actions": {
            "Update_Secret": {
              "type": "ApiConnection",
              "runAfter": {},
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['keeper']['connectionId']"
                  }
                },
                "method": "put",
                "path": "/secrets/@{encodeURIComponent(parameters('secretUid'))}",
                "body": {
                  "notes": "Updated at @{utcNow()}"
                }
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "keeper": {
                "connectionId": "[resourceId('Microsoft.Web/connections', parameters('connectionName'))]",
                "connectionName": "[parameters('connectionName')]",
                "id": "[variables('effectiveKeeperApiId')]"
              }
            }
          },
          "secretUid": {
            "value": "[parameters('secretUid')]"
          }
        }
      }
    }
  ],
  "outputs": {
    "name": {
      "type": "string",
      "value": "[parameters('logicAppName')]"
    },
    "resourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Logic/workflows', parameters('logicAppName'))]"
    },
    "resourceGroupName": {
      "type": "string",
      "value": "[resourceGroup().name]"
    },
    "location": {
      "type": "string",
      "value": "[parameters('location')]"
    },
    "connectionName": {
      "type": "string",
      "value": "[parameters('connectionName')]"
    },
    "nextSteps": {
      "type": "string",
      "value": "[concat('Deployed. To verify quickly without waiting, open Logic App ', parameters('logicAppName'), ' > Overview > Run Trigger > Recurrence. Then check Run history for a successful Update_Secret action and confirm the notes field of secret ', parameters('secretUid'), ' is updated in your Keeper vault.')]"
    }
  }
}
